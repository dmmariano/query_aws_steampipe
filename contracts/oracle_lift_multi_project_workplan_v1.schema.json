{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oracle_lift_multi_project_workplan_v1.schema.json",
  "title": "Oracle Lift Multi-Project Workplan Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "verdict",
    "request",
    "response",
    "journal_event",
    "active_project",
    "isolation",
    "backend_boundary",
    "dba_gaps"
  ],
  "properties": {
    "contract_version": {
      "const": "oracle-lift-multi-project-workplan-v1"
    },
    "verdict": {
      "enum": ["HOLD", "PARTIAL", "READY"]
    },
    "request": {
      "$ref": "#/$defs/prepareRequest"
    },
    "response": {
      "$ref": "#/$defs/prepareResponse"
    },
    "journal_event": {
      "$ref": "#/$defs/journalEvent"
    },
    "active_project": {
      "$ref": "#/$defs/activeProject"
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fail_closed_before_query_or_write",
        "required_scope_fields",
        "physical_mechanism"
      ],
      "properties": {
        "fail_closed_before_query_or_write": {
          "const": true
        },
        "required_scope_fields": {
          "type": "array",
          "prefixItems": [
            { "const": "client_id" },
            { "const": "provider" },
            { "const": "project_ids" },
            { "const": "environment" }
          ],
          "minItems": 4,
          "maxItems": 4
        },
        "physical_mechanism": {
          "enum": [
            "VPD",
            "APPLICATION_CONTEXT",
            "STORED_API_VALIDATION",
            "SCOPED_COLUMNS_AND_STORED_API_VALIDATION",
            "DBA_APPROVED_EQUIVALENT",
            "PENDING_DBA"
          ]
        }
      }
    },
    "backend_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fake_only_allowed",
        "feature_flag_default",
        "real_integration_allowed",
        "renderer_aggregation_allowed",
        "reprocess_without_authorization_allowed"
      ],
      "properties": {
        "fake_only_allowed": {
          "type": "boolean"
        },
        "feature_flag_default": {
          "const": "OFF"
        },
        "real_integration_allowed": {
          "type": "boolean"
        },
        "renderer_aggregation_allowed": {
          "const": false
        },
        "reprocess_without_authorization_allowed": {
          "const": false
        }
      }
    },
    "dba_gaps": {
      "type": "array",
      "minItems": 0,
      "items": {
        "enum": [
          "AUTONOMOUS_DISCOVERY_LIFT_AUTHORIZATION",
          "DISCOVERY_LIFT_OWNER",
          "ACTIVE_PROJECTS_PROJECTION",
          "PREPARE_WORKPLAN_WRITER_API",
          "APPEND_ONLY_JOURNAL",
          "RUN_STATUS_PROJECTION_API",
          "ARTIFACT_REGISTRY_METADATA_ONLY",
          "ISOLATION_MECHANISM",
          "RUNTIME_GRANTS",
          "SECRET_REFERENCE",
          "ENDPOINT_ALIAS",
          "WALLET_REFERENCE",
          "POOL_LIMITS",
          "READ_ONLY_HEALTHCHECK",
          "BACKEND_ROUTE_API",
          "DTO_PUBLICATION",
          "PUBLIC_RUN_STATUS_PROJECTION",
          "CIRCUIT_BREAKER_TIMEOUTS",
          "VPD_APPLICATION_CONTEXT_HARDENING"
        ]
      }
    }
  },
  "$defs": {
    "prepareRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client_id", "provider", "project_ids"],
      "properties": {
        "client_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "environment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "project_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/opaqueId"
          }
        },
        "request_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "idempotency_key": {
          "$ref": "#/$defs/digest"
        },
        "approval_ref": {
          "$ref": "#/$defs/opaqueRef"
        }
      }
    },
    "prepareResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "idempotency_key",
        "status",
        "client_id",
        "provider",
        "project_ids",
        "project_count",
        "counts",
        "artifact_refs",
        "approval",
        "journal_cursor",
        "next_poll_after_ms"
      ],
      "properties": {
        "run_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "idempotency_key": {
          "$ref": "#/$defs/digest"
        },
        "status": {
          "enum": [
            "VALIDATING",
            "REJECTED",
            "QUEUED",
            "RUNNING",
            "PARTIAL_RETRYABLE",
            "READY",
            "EMPTY",
            "FAILED_RETRYABLE",
            "FAILED_FINAL",
            "CANCELLED",
            "ROLLED_BACK"
          ]
        },
        "client_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "provider": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        },
        "project_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/opaqueId"
          }
        },
        "project_count": {
          "type": "integer",
          "minimum": 1
        },
        "counts": {
          "$ref": "#/$defs/counts"
        },
        "artifact_refs": {
          "$ref": "#/$defs/artifactRefs"
        },
        "approval": {
          "$ref": "#/$defs/approval"
        },
        "journal_cursor": {
          "$ref": "#/$defs/opaqueRef"
        },
        "next_poll_after_ms": {
          "type": "integer",
          "minimum": 0
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "journalEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "event_id",
        "event_sequence",
        "event_type",
        "event_status",
        "project_ids_digest",
        "projection_cursor"
      ],
      "properties": {
        "run_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "event_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "event_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "event_type": {
          "enum": [
            "REQUEST_ACCEPTED",
            "PROJECT_SET_VALIDATED",
            "RUN_QUEUED",
            "RUN_STARTED",
            "PROJECT_PROGRESS",
            "ARTIFACTS_PUBLISHED",
            "APPROVAL_REQUIRED",
            "APPROVAL_RECORDED",
            "RUN_READY",
            "RUN_FAILED",
            "RUN_CANCELLED",
            "RUN_ROLLED_BACK"
          ]
        },
        "event_status": {
          "enum": ["INFO", "READY", "PENDING", "WARNING", "ERROR"]
        },
        "client_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "provider": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        },
        "project_ids_digest": {
          "$ref": "#/$defs/digest"
        },
        "project_id_ref": {
          "$ref": "#/$defs/opaqueRef"
        },
        "batch_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "committed_at": {
          "type": "string",
          "format": "date-time"
        },
        "projection_cursor": {
          "$ref": "#/$defs/opaqueRef"
        },
        "retry_after_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "activeProject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client_id",
        "provider",
        "project_id",
        "project_label",
        "active",
        "eligible_for_workplan"
      ],
      "properties": {
        "client_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "provider": {
          "type": "string"
        },
        "project_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "project_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "environment": {
          "type": "string"
        },
        "active": {
          "type": "boolean"
        },
        "eligible_for_workplan": {
          "type": "boolean"
        },
        "blocked_reason_code": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[A-Z0-9_]*$"
        },
        "last_projection_cursor": {
          "$ref": "#/$defs/opaqueRef"
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projects_selected": { "type": "integer", "minimum": 0 },
        "projects_validated": { "type": "integer", "minimum": 0 },
        "resources_total": { "type": "integer", "minimum": 0 },
        "dependencies_total": { "type": "integer", "minimum": 0 },
        "applications_total": { "type": "integer", "minimum": 0 },
        "databases_total": { "type": "integer", "minimum": 0 },
        "files_metadata_total": { "type": "integer", "minimum": 0 },
        "value_items_total": { "type": "integer", "minimum": 0 },
        "warnings_total": { "type": "integer", "minimum": 0 },
        "errors_total": { "type": "integer", "minimum": 0 }
      }
    },
    "artifactRefs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workload_builder_ref": { "$ref": "#/$defs/opaqueRef" },
        "workplan_ref": { "$ref": "#/$defs/opaqueRef" },
        "manifest_ref": { "$ref": "#/$defs/opaqueRef" }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approval_required", "approval_status"],
      "properties": {
        "approval_required": {
          "type": "boolean"
        },
        "approval_status": {
          "enum": ["NOT_REQUIRED", "PENDING", "APPROVED", "REJECTED"]
        },
        "approval_ref": {
          "$ref": "#/$defs/opaqueRef"
        },
        "approval_reason_code": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[A-Z0-9_]*$"
        }
      }
    },
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "opaqueRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_.:/@-]+$"
    },
    "digest": {
      "type": "string",
      "minLength": 32,
      "maxLength": 128,
      "pattern": "^[A-Fa-f0-9]+$"
    }
  }
}
